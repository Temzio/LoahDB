<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>LoahDB</Title>
    <Company>Temzio</Company>
    <Version>2.0.0</Version>
    <PackageId>LoahDB</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>SeyedAli Hoseini</Authors>
    <Description>Embedded JSON document database for .NET — page-file storage, WAL, indexes, query planner, schema, and AES-GCM encryption.</Description>
    <PackageIcon>loahdb.png</PackageIcon>
    <PackageProjectUrl>temzio.ir/LoahDB</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Temzio/LoahDB</RepositoryUrl>
    <ApplicationIcon>loahdb.ico</ApplicationIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="loahdb.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="loahdb.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
