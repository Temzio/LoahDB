<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>loah</ToolCommandName>
    <PackageId>loah</PackageId>
    <Version>2.0.0</Version>
    <Description>Command-line tool for LoahDB stores (info, integrity, vacuum, backup).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoahDB\LoahDB.csproj" />
  </ItemGroup>

</Project>
